# Choose horizondb or flex. Use a new demo database and URL-encode credentials.
POSTGRES_SERVICE=horizondb
AZURE_PG_CONNECTION="postgresql://USER:PASSWORD@HOST:5432/agentdb?sslmode=require"

# HorizonDB: registered model alias, producing 1536 dimensions.
EMBEDDING_MODEL_NAME=default-embedding

# Flex: set POSTGRES_SERVICE=flex, use your embedding deployment name above,
# and fill in these Azure OpenAI settings.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""

# Azure AI Foundry hub-based project (azure-ai-projects 1.0.0b7).
PROJECT_CONNECTION_STRING=""
MODEL_DEPLOYMENT_NAME=""
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED="false"
