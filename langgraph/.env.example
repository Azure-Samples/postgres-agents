# Works with HorizonDB (read-write endpoint) or PostgreSQL Flexible Server.
# Copy the actual hostname and port from your database's connection details.
PGHOST=your-read-write-hostname
PGDATABASE=agentdb
PGUSER=agent_user
PGPASSWORD=replace_me_securely
PGPORT=5432
PGSSLMODE=require

# Use your Azure OpenAI deployment names, not model catalog names.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me_securely
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: set OPENAI_API_KEY instead of Azure OpenAI settings to use OpenAI.
# OPENAI_API_KEY=replace_me_securely
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional tracing is disabled to avoid exporting prompts by default.
LANGSMITH_TRACING=false
